<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/tela"
    android:background="@color/fundo">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/azul">
        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_voltar"
            android:tint="@color/branco"
            android:contentDescription="@string/voltar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/detalhes_curso"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:layout_marginStart="4dp" />
        <ImageView
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/logo_unir"
            android:tint="@color/branco"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@drawable/fundo_foto"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/imagemCurso"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_educacao"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/imagem_curso" />
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="26sp"
                android:textColor="@color/azul_escuro"
                android:id="@+id/txtNome"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/txtGrau"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/azul"
                android:layout_marginTop="6dp"
                app:drawableStartCompat="@drawable/ic_educacao"
                android:drawablePadding="6dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp"
                android:layout_marginTop="18dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtCampus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/texto"
                    android:layout_marginTop="0dp"
                    app:drawableStartCompat="@drawable/ic_campus"
                    android:drawablePadding="10dp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtTurno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/texto"
                    android:layout_marginTop="14dp"
                    app:drawableStartCompat="@drawable/ic_relogio"
                    android:drawablePadding="10dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_descricao"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/sobre_curso"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/azul_escuro" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/texto"
                android:id="@+id/txtDescricao"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/acessar_site"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:textColor="@color/branco"
                app:drawableStartCompat="@drawable/ic_site"
                app:drawableTint="@color/branco"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCompartilhar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/compartilhar"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:textColor="@color/azul"
                app:drawableStartCompat="@drawable/ic_compartilhar"
                app:drawableTint="@color/azul"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@color/azul_claro" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
