<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CursosUNIR" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryDark">@color/azul_escuro</item>
        <item name="colorAccent">@color/azul</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="buttonStyle">@style/BotaoCursos</item>
    </style>
    <style name="BotaoCursos" parent="Widget.AppCompat.Button">
        <item name="backgroundTint">@color/azul</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
